{
  "name": "yt-manager",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../web", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "ytm", "database_id": "5b275893-b291-465c-8bad-0d7d73f39d71", "migrations_dir": "migrations" }
  ],
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "BACKUPS", "id": "e174dd5d50144d0b92376422f8b2f1ca" }],
  "triggers": { "crons": ["*/15 * * * *", "11 */6 * * *"] },
  "vars": { "TZ_NAME": "Asia/Karachi", "SESSION_HOURS": "12", "PBKDF2_ITER": "100000" }
}
